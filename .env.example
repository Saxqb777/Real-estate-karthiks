# Neon pooled connection string (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# Neon direct connection string (migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Login
APP_USERNAME="estates"
APP_PASSWORD="change-me"
# 32+ random chars, signs the session cookie
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: enables "email me" for pending actions
RESEND_API_KEY=""
